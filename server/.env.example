# LifeLink AI Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# JWT Secret for authentication tokens
JWT_SECRET=lifelink_super_secret_jwt_key_2026_dev_mode
JWT_EXPIRES_IN=7d

# Database Configuration (Defaults to MySQL, falls back gracefully to SQLite if MySQL is offline)
DB_ENGINE=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lifelink_ai
SQLITE_PATH=./data/lifelink.sqlite

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
